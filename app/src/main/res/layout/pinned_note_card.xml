<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="165dp"
    android:layout_height="145dp"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@color/navy_blue"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:background="@color/warning_yellow" />

            <TextView
                android:id="@+id/noteTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="My Note"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnPin"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Unpin"
                android:padding="2dp"
                android:src="@drawable/pin"
                android:backgroundTint="@color/warning_yellow" />
        </LinearLayout>


        <TextView
            android:id="@+id/noteContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="This is a preview of the note content..."
            android:textColor="@color/gray_light"
            android:textSize="12sp" />


        <TextView
            android:id="@+id/noteDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Oct 1, 2026"
            android:textColor="@color/gray_light"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>